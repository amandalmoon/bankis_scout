# NEVER paste keys into chat or commit your filled file.
# Read-only market-data keys; NO ORDER ENDPOINTS ARE USED.
KIS_APP_KEY=
KIS_APP_SECRET=
# "prod" reads production market-data; "vps" is a separate sandbox and some endpoints may be unavailable.
KIS_ENV=prod
# Optional disclosure access; register via opendart.fss.or.kr.
DART_API_KEY=
# Report service token stays in this local/server file, never in source or chat.
BRIEFING_READ_TOKEN=
# HTTPS origin and optional prefix only; exclude token, query and credentials.
BRIEFING_BASE_URL=
